#!/bin/sh
# Block large files from entering git history (a 6.5MB dmg once slipped in and
# permanently bloated every clone). Override for a legitimate large asset with:
#   git commit --no-verify
MAX_BYTES=5242880  # 5MB

status=0
git diff --cached --name-only --diff-filter=AM -z | while IFS= read -r -d '' file; do
  size=$(git cat-file -s ":$file" 2>/dev/null || echo 0)
  if [ "$size" -gt "$MAX_BYTES" ]; then
    echo "pre-commit: blocked '$file' ($((size / 1048576))MB > 5MB)." >&2
    echo "Large binaries do not belong in git history. Use a release asset or" >&2
    echo "external storage; bypass intentionally with 'git commit --no-verify'." >&2
    exit 1
  fi
done || status=1

exit $status
